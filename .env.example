# Shopify Storefront API (inventory + checkout).
# Until these are set, lib/commerce/* serves normalized mock data from the
# same shape the Shopify adapter will return, so the switch is a data-layer
# change only — no component should need to change.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# WhatsApp concierge channel. Single source of truth for lib/whatsapp.ts.
# Digits only, with country code, no leading +.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical site URL, used for metadata, OpenGraph and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox public token (pk.*), used by StoreMap for the Visit Store map.
# Get one free at https://account.mapbox.com/access-tokens/.
# Until this is set, VisitStoreSplit falls back to a plain Google Maps embed.
NEXT_PUBLIC_MAPBOX_TOKEN=
